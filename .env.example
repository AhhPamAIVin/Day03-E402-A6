# Chọn Provider muốn sử dụng: gemini | openai | anthropic | openrouter | mock
LLM_PROVIDER=gemini

# Cấu hình API Key tương ứng với Provider đã chọn:
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tùy chọn Model override (Để trống nếu muốn dùng Model mặc định của Provider)
LLM_MODEL=
